# Copy to .env and fill in AI_API_KEY. Never commit .env.
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
SCAMMER_MODEL=openai/gpt-oss-120b
CLASSIFIER_MODEL=openai/gpt-oss-20b
PORT=3001

# Backup provider (Gemini, OpenAI-compatible endpoint) — swap these in only if Groq refuses the role:
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# SCAMMER_MODEL=<gemini model id>
# CLASSIFIER_MODEL=<gemini model id>
